# Local Codex/Next.js runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Use the live CMS API for local website development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_API_BASE_URL=https://cms.vedanga.edu.np/api
CMS_SITE_URL=https://cms.vedanga.edu.np
CMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.vedanga.edu.np,https://cms.vedanga.edu.np

# Prisma is generated during setup. These values are only used if you open
# local CMS/server routes; keep production credentials out of this file.
DATABASE_URL=mysql://vedanga:vedanga@127.0.0.1:3306/vedanga_dev
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=change-this-local-password
CMS_SESSION_SECRET=change-this-local-session-secret

# Local uploads are ignored by Git.
CMS_UPLOAD_DIR=./uploads
CMS_UPLOAD_PUBLIC_URL=http://localhost:3000/uploads
