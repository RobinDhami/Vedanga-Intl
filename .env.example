# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CPANEL_BUILD=1

# Public site / CMS routing
NEXT_PUBLIC_SITE_URL=https://www.vedanga.edu.np
NEXT_PUBLIC_CMS_API_BASE_URL=https://cms.vedanga.edu.np/api
CMS_SITE_URL=https://cms.vedanga.edu.np
CMS_ALLOWED_ORIGINS=https://vedanga.edu.np,https://www.vedanga.edu.np,https://cms.vedanga.edu.np

# Admin authentication (replace every placeholder before starting production)
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=change-this-password
CMS_SESSION_SECRET=replace-this-with-a-long-random-secret

# Persistence
DATABASE_URL=mysql://DATABASE_USER:URL_ENCODED_PASSWORD@localhost:3306/DATABASE_NAME
CMS_UPLOAD_DIR=/home/CPANEL_USERNAME/vedanga_uploads
CMS_UPLOAD_PUBLIC_URL=https://cms.vedanga.edu.np/uploads
